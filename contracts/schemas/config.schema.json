{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orb/config.schema.json",
  "title": "orb/{id}/config (hub → orb, retained)",
  "type": "object",
  "required": ["state"],
  "properties": {
    "state": {"enum": ["pending", "active"]},
    "code": {"type": "string", "pattern": "^[0-9]{4}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 32},
    "owner": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "brightness": {"type": "integer", "minimum": 0, "maximum": 100},
    "quiet": {
      "type": ["object", "null"],
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "end": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"}
      },
      "additionalProperties": false
    },
    "tz": {"type": "string", "minLength": 3, "maxLength": 64},
    "media_base": {"type": "string", "pattern": "^https?://[^/\\s]+$"},
    "fw": {
      "type": "object",
      "required": ["version", "model", "url", "sha256", "size"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"},
        "model": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,31}$"},
        "url": {"type": "string", "pattern": "^/media/fw/[A-Za-z0-9._-]+\\.bin$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 65536, "maximum": 3145728}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "pending"}}}, "then": {"required": ["code"]}},
    {"if": {"properties": {"state": {"const": "active"}}}, "then": {"required": ["name", "media_base"]}}
  ]
}

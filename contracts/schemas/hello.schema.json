{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orb/hello.schema.json",
  "title": "orb/{id}/hello (orb → hub, retained)",
  "type": "object",
  "required": ["fw", "w", "h", "caps"],
  "properties": {
    "fw": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+].+)?$"},
    "model": {"type": "string", "maxLength": 64},
    "w": {"type": "integer", "minimum": 1},
    "h": {"type": "integer", "minimum": 1},
    "caps": {
      "type": "array",
      "items": {"type": "string", "enum": ["touch", "led", "speaker", "imu"]},
      "uniqueItems": true
    }
  }
}

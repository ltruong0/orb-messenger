# Copy to .env (gitignored). Used by `make mosquitto-passwd` and local runs.
MQTT_HOST=mqtt.marcellolab.com
MQTT_PORT=1883
MQTT_HUB_PASSWORD=change-me-hub
MQTT_ORB_PASSWORD=change-me-orb

# msg-hub (make hub-run reads MQTT_HUB_PASSWORD as MQTT_PASSWORD)
HUB_PIN=change-me-4-digits
SESSION_SECRET=change-me-at-least-16-chars
# MEDIA_BASE_URL=http://orb.marcellolab.com   # what orbs fetch /media from; defaults to this laptop's IP for hub-run
# HUB_TZ=CST6CDT,M3.2.0,M11.1.0              # POSIX TZ sent to orbs for quiet hours

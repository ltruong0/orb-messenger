; Copy to secrets.ini (gitignored) or run `make fw-secrets` from the repo root.
; Build-time defaults the orb seeds its NVS with on first boot. Leave the Wi-Fi
; lines out to use the on-screen setup portal instead.
[secrets]
build_flags =
    -DORB_WIFI_SSID=\"MyNetwork\"
    -DORB_WIFI_PASS=\"wifi-password\"
    -DORB_MQTT_HOST=\"mqtt.marcellolab.com\"
    -DORB_MQTT_PASS=\"the-orb-mqtt-password\"
;   -DORB_LED_PIN=17
